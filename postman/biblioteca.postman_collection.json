          "mode": "raw",
          "raw": "{\"alunoId\": \"a1\", \"livroId\": \"L4\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"mensagem de limite\", () => pm.expect(pm.response.json().erro).to.eql(\"Limite de 3 livros atingido\"));"
            ]
          }
        }
      ]
    },
