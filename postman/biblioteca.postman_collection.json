{
  "info": {
    "name": "Sistema de Biblioteca - Teste 3 (API de empréstimo)",
    "description": "Teste 3: valores limite no número de livros por aluno e regra da reserva. Execute na ordem (Run collection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Reiniciar dados",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reset",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reset"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
