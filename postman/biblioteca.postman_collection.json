        "body": {
          "mode": "raw",
          "raw": "{\"alunoId\": \"a1\", \"livroId\": \"L3\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Ana fica com 3 livros\", () => pm.expect(pm.response.json().livrosComAluno).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Ana pede o 4º livro (L4) - acima do limite: recusado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/emprestimos",
          "host": [
